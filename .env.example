# ---- App ----
ENV=development
LOG_LEVEL=INFO

# ---- API auth ----
# Required in any non-development ENV — the backend refuses to start
# without it. Generate a strong random value, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# Signs per-user session JWTs (see backend/app/services/auth_service.py).
# Required for login/register to work at all, in ANY environment —
# generate the same way as API_KEY. Rotating it invalidates every active
# session.
JWT_SECRET=
# Controls the session cookie's Secure attribute. Leave unset to auto-pick
# (Secure everywhere except ENV=development). Set explicitly to `false`
# ONLY for a deployment with no domain/TLS yet — a browser silently drops
# a Secure cookie sent over plain HTTP, which makes every login look like
# it worked and then 401 on the very next request. Unset/remove this (or
# set `true`) as soon as the deployment is behind HTTPS.
COOKIE_SECURE=
# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Database ----
# Used by backend/worker/bot (async driver) and by docker-compose's postgres service.
DATABASE_URL=postgresql+asyncpg://leadhunter:leadhunter@postgres:5432/leadhunter
POSTGRES_USER=leadhunter
POSTGRES_PASSWORD=leadhunter
POSTGRES_DB=leadhunter

# ---- Telegram monitoring (Telethon) ----
# Get API_ID / API_HASH from https://my.telegram.org
# Leave empty to run without Telegram monitoring (pipeline stays testable via API).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Path inside the `telegram_sessions` docker volume (see docker-compose.yml)
# so the session survives container restarts. For local (non-Docker) runs,
# any writable path/filename works.
TELEGRAM_SESSION=sessions/leadhunter_session
# Comma-separated list of PUBLIC telegram channel/group usernames you are
# allowed to monitor, e.g. "some_public_channel,another_public_group"
TELEGRAM_ALLOWED_SOURCES=

# ---- Telegram notification bot (aiogram) ----
BOT_TOKEN=
NOTIFICATION_CHAT_ID=
# No leading @ — used to build the "Войти через Telegram" deep link.
TELEGRAM_BOT_USERNAME=

# ---- Public site (bot messages link back here, e.g. /privacy) ----
# Bare IP for now (no domain/TLS yet, see PROJECT_AUDIT.md) — update once
# a real domain exists.
PUBLIC_SITE_URL=http://localhost:3000

# ---- AI provider ----
# "mock" runs a deterministic local analyzer with no external calls — use
# this until real AI credentials are available.
# "openai_compatible" calls AI_BASE_URL with an OpenAI-compatible /chat/completions API.
AI_PROVIDER=mock
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# ---- Lead scoring / notification thresholds ----
NOTIFICATION_THRESHOLD=60
VERY_HOT_THRESHOLD=90
MIN_STORE_THRESHOLD=40

# ---- Scheduler ----
TELEGRAM_POLL_INTERVAL_SECONDS=60

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shown on /support and referenced in the privacy policy — set to a real
# inbox before public launch.
NEXT_PUBLIC_SUPPORT_EMAIL=support@readhunter.example
